algoritmo "exercicio7A"
  // Disciplina : [Linguagem e Lógica de Programação]
  // Professor : Jailson Costa
  // Descrição : Ler uma temperatura em graus Celsius e apresentá-la convertida em graus Fahrenheit. A fórmula de conversão é F (9 * C + 160) / 5, sendo F a temperatura em Fahrenheit e C a temperatura em Celsius

  // Autor(a) : Guilherme Miranda de Morais
  // Data atual : 23/09/2026
var
  // Seção de Declarações das variáveis
  celsius, fahrenheit:real

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite a temperatura em graus celsius")
  Leia(celsius)

  fahrenheit <- (9 * celsius + 160) / 5

  Escreval("A temperatura convertida em graus fahrenheit é: " + fahrenheit)

fimalgoritmo