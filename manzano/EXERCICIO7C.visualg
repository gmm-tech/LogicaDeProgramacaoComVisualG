algoritmo "exercicio7C"
  // Disciplina : [Linguagem e Lógica de Programação]
  // Professor : Jailson Costa
  // Descrição : Calcular e apresentar o valor do volume de uma lata de óleo, utilizando a fórmula: Volume π * Raio² * Altura

  // Autor(a) : Guilherme Miranda de Morais
  // Data atual : 23/09/2026
var
  // Seção de Declarações das variáveis
  volume, raio, altura:real

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite o raio da lata")
  Leia(raio)
  Escreval("Digite a altura da lata")
  Leia(altura)

  volume <- 3.14 * (raio * raio) * altura

  Escreval("Volume = ", volume)

fimalgoritmo