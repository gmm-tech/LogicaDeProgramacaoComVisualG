algoritmo "exercicio7H"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Elaborar um programa que calcule e apresente o volume de uma caixa retangular, por meio da fórmula VOLUME = COMPRIMENTO * LARGURA * ALTURA.

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 26/09/2026
var
  // Seção de Declarações das variáveis
  comprimento, largura, altura, volume:real

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite a altura")
  Leia(altura)
  Escreval("Digite a largura")
  Leia(largura)
  Escreval("Digite o comprimento")
  Leia(comprimento)

  volume <- comprimento * largura * altura

  Escreval("O volume é: ", volume)

fimalgoritmo