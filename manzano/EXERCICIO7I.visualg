algoritmo "exercicio7I"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Ler dois inteiros (variáveis A e B) e imprimir o resultado do quadrado da diferença do primeiro valor pelo segundo.

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 26/09/2026
var
  // Seção de Declarações das variáveis
  A, B, diferenca:inteiro

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite o numero A")
  Leia(A)
  Escreval("Digite o numero B")
  Leia(B)

  diferenca <- (A - B) * (A - B)
  Escreval("A diferença é de: ", diferenca)

fimalgoritmo