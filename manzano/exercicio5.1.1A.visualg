algoritmo "exercicio5.1.1A"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar os resultados de uma tabuada de multiplicar (de 1 até 10) de um número qualquer.

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 26/09/2026
var
  // Seção de Declarações das variáveis
  numero, multiplicador:inteiro

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite um número para ver sua tabuada")
  Leia(numero)

  enquanto multiplicador <= 10 faca
    Escreval(numero, " x ", multiplicador, " = ", numero * multiplicador)
    multiplicador <- multiplicador + 1
  fimenquanto

fimalgoritmo