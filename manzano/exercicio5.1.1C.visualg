algoritmo "exercicio5.1.1C"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Elaborar um programa que apresente no final o somatório dos valores pares existentes na faixa de 1 até 500.

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 26/09/2026
var
  // Seção de Declarações das variáveis
  numero, soma:inteiro

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("somatório dos valores pares existentes na faixa de 1 até 500.")

  soma <- 0
  numero <- 2

  enquanto numero <= 500 faca
    soma <- soma + numero
    numero <- numero + 2
  fimenquanto

  Escreval(soma)

fimalgoritmo