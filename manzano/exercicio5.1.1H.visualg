algoritmo "exercicio5.1.1H"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Elaborar um programa que apresente os valores de conversão de graus Celsius em Fahrenheit, de 10 em 10 graus, iniciando a contagem em 10 graus Celsius e finalizando em 100 graus Celsius[cite: 1]. O programa deve apresentar os valores das duas temperaturas[cite: 1]. A fórmula de conversão é F = (9 * C + 160) / 5, sendo F a temperatura em Fahrenheit e C a temperatura em Celsius[cite: 1].

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  celsius, fahrenheit:real
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  celsius <- 10

  enquanto celsius <= 100 faca
    fahrenheit <- (9 * celsius + 160) / 5

    Escreval("Celsius: ", celsius)
    Escreval("Fahrenheit: ", fahrenheit)

    celsius <- celsius + 10
  fimenquanto
fimalgoritmo