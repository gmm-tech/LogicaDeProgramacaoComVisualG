algoritmo "exercicio5.1.1I"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Efetuar a leitura de 10 valores numéricos e apresentar o total do somatório e a média aritmética dos valores lidos.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  contador:inteiro
  valor, soma, media:real
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  soma <- 0
  contador <- 1

  enquanto contador <= 10 faca
    Escreva("Digite o ", contador, "º valor: ")
    Leia(valor)

    soma <- soma + valor
    contador <- contador + 1
  fimenquanto

  media <- soma / 10

  Escreval("")
  Escreval("Total do somatório: ", soma)
  Escreval("Média aritmética: ", media)

fimalgoritmo