algoritmo "exercicio5.1.1L"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Efetuar a leitura de valores inteiros positivos até informar um negativo e apresentar o maior e o menor valor lido.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  valor, maior, menor:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreva("Digite um valor inteiro positivo (ou negativo para encerrar): ")
  Leia(valor)

  se valor >= 0 entao
    maior <- valor
    menor <- valor

    enquanto valor >= 0 faca
      se valor > maior entao
        maior <- valor
      fimse

      se valor < menor entao
        menor <- valor
      fimse

      Escreva("Digite um valor inteiro positivo (ou negativo para encerrar): ")
      Leia(valor)
    fimenquanto

    Escreval("")
    Escreval("Maior valor informado: ", maior)
    Escreval("Menor valor informado: ", menor)
  senao
    Escreval("Nenhum valor positivo foi digitado.")
  fimse

fimalgoritmo