algoritmo "exercicio7M"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição :  Elaborar um programa que efetue a leitura de três valores (A,B e C) e apresente como resultado final o quadrado da soma dos três valores lidos.

// Autor(a) : Guilherme Miranda de Morais
// Data atual : 26/09/2026
var
  // Seção de Declarações das variáveis
  A, B, C, soma:real

inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreval("Digite o número A")
  Leia(A)
  Escreval("Digite o número B")
  Leia(B)
  Escreval("Digite o número C")
  Leia(C)

  soma <- (A * A) + (B * B) + (C * C)

  Escreval("A soma dos quadrados é:", )

fimalgoritmo