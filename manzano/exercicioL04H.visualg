algoritmo "L04H"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Calcular a área total de uma residência até que o usuário informe "NAO".
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  nome, resposta: caractere
  largura, comprimento, areaComodo, areaTotal: real
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  areaTotal <- 0

  repita
    Escreva("Digite o nome do cômodo: ")
    Leia(nome)
    Escreva("Digite a largura do cômodo (m): ")
    Leia(largura)
    Escreva("Digite o comprimento do cômodo (m): ")
    Leia(comprimento)

    areaComodo <- largura * comprimento
    areaTotal <- areaTotal + areaComodo

    Escreval("A área do(a) ", nome, " é: ", areaComodo, " m²")
    Escreval("")

    Escreva("Deseja continuar calculando novos cômodos? (SIM/NAO): ")
    Leia(resposta)
    Escreval("")
  ate Maiusc(resposta) = "NAO"

  Escreval("Área total acumulada da residência: ", areaTotal, " m²")

fimalgoritmo