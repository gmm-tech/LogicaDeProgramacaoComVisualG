algoritmo "L04I"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Leitura de inteiros positivos até informar um negativo, exibindo maior e menor valor.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  valor, maior, menor:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  Escreva("Digite um valor inteiro positivo (ou negativo para encerrar): ")
  Leia(valor)

  se valor >= 0 entao
    maior <- valor
    menor <- valor

    repita
      se valor > maior entao
        maior <- valor
      fimse

      se valor < menor entao
        menor <- valor
      fimse

      Escreva("Digite um valor inteiro positivo (ou negativo para encerrar): ")
      Leia(valor)
    ate valor < 0

    Escreval("")
    Escreval("Maior valor informado: ", maior)
    Escreval("Menor valor informado: ", menor)
  senao
    Escreval("Nenhum valor positivo foi digitado.")
  fimse

fimalgoritmo