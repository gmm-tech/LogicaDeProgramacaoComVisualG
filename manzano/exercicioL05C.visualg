algoritmo "exercicioL05C"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar o total da soma obtida dos cem primeiros números inteiros.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  contador, somaTotal:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  somaTotal <- 0

  para contador de 1 ate 100 faca
    somaTotal <- somaTotal + contador
  fimpara

  Escreval("O total da soma dos 100 primeiros números inteiros é: ", somaTotal)

fimalgoritmo