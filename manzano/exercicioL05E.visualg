algoritmo "exercicioL05E"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar todos os valores numéricos inteiros ímpares situados na faixa de 0 a 20.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  contador:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  para contador de 0 ate 20 faca
    se contador mod 2 <> 0 entao
      Escreval("Número ímpar: ", contador)
    fimse
  fimpara

fimalgoritmo