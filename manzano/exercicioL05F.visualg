algoritmo "exercicioL05F"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar todos os números divisíveis por 4 que sejam menores que 200.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  contador:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  para contador de 1 ate 199 faca
    se contador mod 4 = 0 entao
      Escreval("Número divisível por 4: ", contador)
    fimse
  fimpara

fimalgoritmo