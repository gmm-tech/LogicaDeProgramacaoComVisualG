algoritmo "exercicioL05I"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar a série de Fibonacci até o 15º termo.
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  contador, termoAnterior, termoAtual, proximoTermo:inteiro
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  termoAnterior <- 0
  termoAtual <- 1

  Escreval("Série de Fibonacci até o 15º termo:")

  para contador de 1 ate 15 faca
    Escreval("Termo ", contador, ": ", termoAtual)
    proximoTermo <- termoAnterior + termoAtual
    termoAnterior <- termoAtual
    termoAtual <- proximoTermo
  fimpara

fimalgoritmo