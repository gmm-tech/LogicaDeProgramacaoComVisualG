algoritmo "exercicioL05J"
// Disciplina : [Linguagem e Lógica de Programação]
// Professor : Jailson Costa
// Descrição : Apresentar os valores de conversão de Celsius para Fahrenheit de 10 em 10 graus (10°C a 100°C).
// Autor(a) : Guilherme Miranda de Morais
// Data atual : 27/09/2026
var
  // Seção de Declarações das variáveis
  celsius:inteiro
  fahrenheit:real
inicio

  // Seção de Comandos, procedimento, funções, operadores, etc...
  para celsius de 10 ate 100 passo 10 faca
    fahrenheit <- (9 * celsius + 160) / 5
    Escreval("Celsius: ", celsius, " °C  |  Fahrenheit: ", fahrenheit, " °F")
  fimpara

fimalgoritmo